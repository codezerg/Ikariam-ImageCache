{
  "manifest_version": 3,
  "name": "Ikariam Image Cache",
  "version": "0.1.0",
  "description": "Serves Ikariam skin images from the extension package instead of re-downloading them from the game server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.ikariam.gameforge.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ikariam.gameforge.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Ikariam Helper",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cached-images",
        "enabled": true,
        "path": "rules/redirects.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "*://*.ikariam.gameforge.com/*"
      ]
    }
  ]
}
